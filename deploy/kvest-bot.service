[Unit]
Description=Telegram quest bot Petrozavodsk
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/kvest-bot
EnvironmentFile=/opt/kvest-bot/.env
ExecStart=/opt/kvest-bot/.venv/bin/python -m bot
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
